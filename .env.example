# Copy to .env or run ./scripts/install.sh --model-dir /absolute/path/to/models
# The model files are not distributed with this repository.
MODEL_DIR=/absolute/path/to/Gemma4-26B-A4B-QAT-MTP
MODEL_FILE=Gemma4-26B-A4B-QAT-Uncensored-HauhauCS-Balanced-Q4_K_M.gguf
MTP_FILE=mtp-gemma-4-26B-A4B-it.gguf

# Conservative RTX 3070 8GB starting profile; hardware validation is still required.
CONTEXT_SIZE=16384
CPU_MOE_LAYERS=30
GPU_LAYERS=99
GPU_DEVICE=0
CUDA_ARCH=86
BUILD_JOBS=4
UBATCH_SIZE=128
PORT=8096
